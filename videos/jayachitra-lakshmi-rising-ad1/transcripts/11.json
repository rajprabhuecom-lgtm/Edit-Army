[{"s": 0.0, "e": 8.84, "t": " லக்ஷ்மி ரைசிங் ஓர்க்ஷாப்புக்கு இப்பவே ரெஜிஸ்டர் பண்ணுங்க. வாங்க உங்க கரியரியும் பணத்தியும் சேர்ந்து மனிபெஸ்ட் பண்ணலாம்.", "w": [[0.0, 0.88, " லக்ஷ்மி"], [0.88, 1.5, " ரைசிங்"], [1.5, 2.38, " ஓர்க்ஷாப்புக்கு"], [2.38, 2.94, " இப்பவே"], [2.94, 3.42, " ரெஜிஸ்டர்"], [3.42, 3.82, " பண்ணுங்க."], [3.94, 4.9, " வாங்க"], [4.9, 5.58, " உங்க"], [5.58, 6.22, " கரியரியும்"], [6.22, 7.18, " பணத்தியும்"], [7.18, 7.8, " சேர்ந்து"], [7.8, 8.36, " மனிபெஸ்ட்"], [8.36, 8.84, " பண்ணலாம்."]]}]