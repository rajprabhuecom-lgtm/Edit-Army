[{"s": 0.0, "e": 7.98, "t": " நானும் ஒரு பெண்ணா, எல்லா கஷ்டங்களை தாண்டி வந்தவைதான். அதனாலதான் என்னுடைய கமின்னிட்டில் ஒரு சிரிக்டான ரூல் இருக்கு.", "w": [[0.0, 0.8, " நானும்"], [0.8, 0.96, " ஒரு"], [0.96, 1.3, " பெண்ணா,"], [1.42, 2.2, " எல்லா"], [2.2, 2.74, " கஷ்டங்களை"], [2.74, 3.1, " தாண்டி"], [3.1, 3.78, " வந்தவைதான்."], [3.78, 5.02, " அதனாலதான்"], [5.02, 5.66, " என்னுடைய"], [5.66, 6.4, " கமின்னிட்டில்"], [6.4, 6.7, " ஒரு"], [6.7, 7.28, " சிரிக்டான"], [7.28, 7.66, " ரூல்"], [7.66, 7.98, " இருக்கு."]]}]